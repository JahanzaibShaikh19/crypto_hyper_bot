# ═══════════════════════════════════════════
# CRYPTO HYPER BOT — ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════

# Telegram Bot (required)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Binance (public API — leave empty, not required for signals)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# NOTE: CryptoPanic free API discontinued April 1, 2026
# News now fetched from free RSS: CoinDesk, CoinTelegraph, Decrypt, TheBlock
# No API key needed — zero cost, works out of the box.

# Coins to monitor (comma-separated Binance USDT pairs)
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,AVAXUSDT

# Signal thresholds
LONG_THRESHOLD=5.5
SHORT_THRESHOLD=-5.5

# Minimum pipelines agreeing before signal fires (Hsaka rule)
MIN_PIPELINE_AGREEMENT=3

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Timezone for event calendar
TIMEZONE=UTC

# Cache TTLs in seconds
CACHE_OHLCV=900
CACHE_NEWS=1800
CACHE_FA=14400
